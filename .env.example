# Copy this file to ".env" (it is gitignored) if you run SONIVERSE without the desktop app, or just prefer a file.
# In the desktop app you can instead paste keys in Settings > AI Providers (they are encrypted by your OS).
#
# SEVERAL KEYS PER PROVIDER: separate them with commas (or put one per line inside quotes).
# When one key hits its quota / rate limit or is rejected, the next one is used automatically.
GEMINI_FREE_API_KEY=
GEMINI_PAID_API_KEY=
GROQ_API_KEY=

# Optional (cloud transcription / SupoClip engine)
ASSEMBLYAI_API_KEY=
SUPOCLIP_API_KEY=

# Providers you add in the app (Settings > AI providers > Add another provider) use X_<NAME>_API_KEY, e.g.:
# X_OPENROUTER_API_KEY=key1,key2
# X_CEREBRAS_API_KEY=
# X_CUSTOM_API_KEY=
